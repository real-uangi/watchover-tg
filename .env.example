# External PostgreSQL; this file does not start it.
DB_DSN=postgres://watchover:CHANGE_ME@127.0.0.1:5432/watchover?sslmode=disable
WATCHOVER_PUBLIC_URL=https://watchover.example.com
WATCHOVER_ADMIN_PASSWORD=CHANGE_ME
# Standard Base64 encoding of a random 32-byte key. Keep stable and back up.
WATCHOVER_ENCRYPTION_KEY=
RUN_MODE=release
HTTP_PORT=8080
# Leave REDIS_ADDR and REDIS_PASSWORD unset: task uses LocalKV.
